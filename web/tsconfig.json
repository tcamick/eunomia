{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["vite/client"],
    // A module the tests import may import its siblings with ".ts", as
    // Node's test runner needs; Vite builds, TypeScript only checks.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"],
  // Tests run under Node's own runner (npm test), which strips the types.
  "exclude": ["src/**/*.test.ts"]
}
