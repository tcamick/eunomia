{
 "uid": "eunomia-overview",
 "title": "Eunomia",
 "tags": [
  "eunomia"
 ],
 "timezone": "browser",
 "editable": true,
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Jobs (from the job history in SQLite, read by the server at each scrape)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "title": "Last run",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A",
     "expr": "eunomia_job_last_run_ok",
     "legendFormat": "{{job}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "failed"
        },
        "1": {
         "text": "ok"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {},
   "description": "Whether each job's last run succeeded."
  },
  {
   "id": 3,
   "title": "Hours since last success",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A",
     "expr": "(time() - eunomia_job_last_success_timestamp_seconds) / 3600",
     "legendFormat": "{{job}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "h"
    },
    "overrides": []
   },
   "options": {},
   "description": "A job that stops succeeding shows here first."
  },
  {
   "id": 4,
   "title": "History readable",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A",
     "expr": "eunomia_job_history_up",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "failed"
        },
        "1": {
         "text": "ok"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {},
   "description": "0 means the server could not read the job history at the last scrape."
  },
  {
   "id": 5,
   "title": "Server up",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 6,
    "y": 7,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A",
     "expr": "up{namespace=\"eunomia\"}",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "failed"
        },
        "1": {
         "text": "ok"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Last push age",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 7,
    "w": 12,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A",
     "expr": "time() - push_time_seconds{job=\"eunomia-batch\"}",
     "legendFormat": "{{batch}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {},
   "description": "How long ago each batch last pushed to the Pushgateway (beholder ADR 0002)."
  },
  {
   "id": 7,
   "type": "row",
   "title": "Outside sources (pushed by each batch run at its end; values are that run's, not a running total)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 8,
   "title": "Requests in each batch's last run",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A",
     "expr": "eunomia_fetch_requests_total{job=\"eunomia-batch\"}",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "Per source and result. A run of server_error or transport_error means a source is down or has moved.",
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {}
    }
   ]
  },
  {
   "id": 9,
   "type": "row",
   "title": "App",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 10,
   "title": "Requests by route and code",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A",
     "expr": "sum by (route, code) (rate(eunomia_http_requests_total[5m]))",
     "legendFormat": "{{route}} {{code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  }
 ]
}
